#!/bin/sh
# Hook local de pre-push: lo lento.
#
# Corre lo que tarda decenas de segundos, para que no estorbe en cada commit.
# Saltear cuando haga falta: git push --no-verify

set -e

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm no está en el PATH; se saltea la verificación."
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "pre-push: falta node_modules; corré pnpm install antes de subir."
  exit 1
fi

echo "pre-push: prettier --check"
pnpm run format:check

echo "pre-push: eslint"
pnpm run lint

echo "pre-push: vitest"
pnpm run test

# En otra carpeta: si fuera a .next, rompería el `next dev` que esté corriendo.
echo "pre-push: next build"
NEXT_DIST_DIR=.next-check pnpm run build

echo "pre-push: espejos"
tool/check-mirrors.sh

exit 0
