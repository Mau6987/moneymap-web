# Normaliza los finales de línea a LF en todos los archivos de texto.
# Es obligatorio para los hooks de .githooks, que corren con sh en Windows:
# un hook con CRLF falla con "bad interpreter: /bin/sh^M".
* text=auto eol=lf

# Archivos binarios: nunca se normalizan
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
