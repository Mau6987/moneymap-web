# Copia este archivo como .env.local y ajusta los valores.
# Un archivo .example NUNCA lleva un valor real (docs/engineering.md §1.5.2).

# Origen de la API de MoneyMap, sin /v1 (las rutas del contrato ya lo traen).
# Solo del lado del servidor: las llamadas salen de route handlers, no del navegador.
API_BASE_URL=http://localhost:8000

# URL pública de este cliente.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo demo: datos falsos en lugar de la API, para revisar el diseño sin backend.
# Nunca en producción. Correos de prueba en docs/specs/008-inicio-sesion/spec.md.
DEMO=false

# Client ID de tipo Web de Google, para "Continuar con Google" (MM-127). Es el
# mismo GOOGLE_CLIENT_ID del backend, que lo usa como audiencia del id_token.
# Vacío: el botón de Google no aparece. En Google Cloud, sumar la URL de este
# cliente como "Origen autorizado de JavaScript".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
